# Create a Google Cloud OAuth web client and enable the Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3100/auth/google/callback
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
PORT=3100
# Optional alternate SQLite file path (useful for isolated local tests).
# MAIL_DB_PATH=/tmp/mail-sender-test.sqlite
# Conservative defaults; your email provider's actual limits still apply.
SEND_INTERVAL_MS=30000
DAILY_SEND_LIMIT=50

# Set true to send with SMTP instead of Gmail OAuth. Restart the API after changing it.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
